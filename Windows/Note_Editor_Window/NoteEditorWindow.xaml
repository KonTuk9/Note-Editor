<c:UiWindow x:Class="Noteeditor.Windows.Note_Editor_Window.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:c="clr-namespace:Noteeditor.Abstractions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Noteeditor.Windows.Note_Editor_Window"
        d:DataContext="{d:DesignInstance local:NoteEditorViewModel}"
        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
        mc:Ignorable="d"  Height="450" Width="800">
    <c:UiWindow.InputBindings>
        <KeyBinding Command="{Binding OpenStartWindowCommand}" Key="Esc" Modifiers="Shift"/>
        <KeyBinding Command="{Binding SaveCommand}" Key="S" Modifiers="Ctrl"/>
    </c:UiWindow.InputBindings>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="titleBar" Title="{Binding Note.Name}" Icon="{Binding CurrentIcon}"/>

        <Menu Grid.Row="1">
            <ui:MenuItem Header="File" Icon="{ui:SymbolIcon Symbol=Folder16}" Width="100">
                <ui:MenuItem Command="{Binding OpenStartWindowCommand}" Header="Start window" Icon="{ui:SymbolIcon Symbol=Home16}" InputGestureText="Shift + Esc"/>
                <Separator/>
                <ui:MenuItem Command="{Binding SaveCommand}" Header="Save" Icon="{ui:SymbolIcon Symbol=Save16}" InputGestureText="Ctrl + S"/>
                <ui:MenuItem Command="{Binding ExitCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=c:UiWindow}}" Header="Exit" Icon="{ui:SymbolIcon Symbol=ArrowExit20}" InputGestureText="Alt + F4"/>
            </ui:MenuItem>
            <ui:MenuItem Header="Edit" Icon="{ui:SymbolIcon Symbol=Edit16}" Width="100">
                <ui:MenuItem Command="Undo" Header="Undo" Icon="{ui:SymbolIcon Symbol=ArrowUndo16}"/>
                <ui:MenuItem Command="Redo" Header="Redo" Icon="{ui:SymbolIcon Symbol=ArrowRedo16}"/>
                <Separator/>
                <ui:MenuItem Command="SelectAll" Header="Select all" Icon="{ui:SymbolIcon Symbol=SquareHint16}"/>
                <ui:MenuItem Command="Copy" Header="Copy" Icon="{ui:SymbolIcon Symbol=Copy16}"/>
                <ui:MenuItem Command="Cut" Header="Cut" Icon="{ui:SymbolIcon Symbol=Cut20}"/>
                <ui:MenuItem Command="Paste" Header="Paste" Icon="{ui:SymbolIcon Symbol=ClipboardPaste16}"/>
            </ui:MenuItem>
        </Menu>

        <ui:TextBox x:Name="textBox" TextWrapping="Wrap" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Text..." Grid.Row="2" Margin="8" AcceptsTab="True" AcceptsReturn="True"/>

        <ui:SnackbarPresenter x:Name="snackbarPresenter" Grid.RowSpan="3"/>
    </Grid>
</c:UiWindow>
