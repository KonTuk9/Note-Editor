<c:UiWindow x:Class="Noteeditor.Windows.Main_Window.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Noteeditor.Windows.Main_Window"
            xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
            d:DataContext="{d:DesignInstance local:MainViewModel}"
            Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
            Background="{ui:ThemeResource}"
        xmlns:c="clr-namespace:Noteeditor.Abstractions"
        mc:Ignorable="d"
        Title="MainWindow" MinHeight="480" MinWidth="720">
    <Grid>
        <ui:TitleBar x:Name="titleBar" Title="Note editor" Icon="{Binding CurrentIcon}"/>

        <ui:NavigationView x:Name="navigationView" TitleBar="{Binding ElementName=titleBar}" MenuItemsSource="{Binding Menu}" FooterMenuItemsSource="{Binding FooterMenu}" OpenPaneLength="180" IsFooterSeparatorVisible="False"/>

        <ui:SnackbarPresenter x:Name="snackbarPresenter"/>
        <ContentPresenter x:Name="dialogPresenter"/>
    </Grid>
</c:UiWindow>
